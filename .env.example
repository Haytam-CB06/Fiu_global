# Application URLs
APP_BASE_URL=http://127.0.0.1:5099
GOOGLE_REDIRECT_URI=http://127.0.0.1:5099/auth/google/callback
GOOGLE_ALLOWED_REDIRECT_URIS=http://127.0.0.1:5099/auth/google/callback

# MySQL database
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=your_database_name
DB_USERNAME=your_database_user
DB_PASSWORD=your_database_password
# Optional full connection string. If set, this overrides DB_HOST/DB_PORT/DB_DATABASE/DB_USERNAME/DB_PASSWORD.
DB_CONNECTION_STRING=

# Google OAuth
# Google Cloud Console OAuth client type must be "Web application".
# Local authorized JavaScript origin: http://127.0.0.1:5099
# Local authorized redirect URI: http://127.0.0.1:5099/auth/google/callback
# Production (replace the values above in the server .env):
# APP_BASE_URL=https://global.fnlsrv.website
# GOOGLE_REDIRECT_URI=https://global.fnlsrv.website/auth/google/callback
# GOOGLE_ALLOWED_REDIRECT_URIS=https://global.fnlsrv.website/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# RMS and Leave secure-launch configuration
# These are public HTTPS destinations, not OAuth secrets. FIU Global accepts
# only these exact allowlisted paths and never adds cookies, email addresses,
# access tokens, refresh tokens, or query parameters to the redirect.
RMS_SSO_START_URL=https://rms.fnlsrv.website/Auth/googleLogin.php
RMS_SSO_DASHBOARD_URL=https://rms.fnlsrv.website/
LEAVE_SSO_START_URL=https://leave.fnlsrv.website/google_login.php
LEAVE_SSO_DASHBOARD_URL=https://leave.fnlsrv.website/

# Configure the following on the RMS and Leave hosts respectively, never in
# browser code and never in FIU Global's public/static files. Each platform
# needs its OWN Google OAuth web client and its own exact callback handler.
# RMS_GOOGLE_CLIENT_ID=your-rms-google-client-id.apps.googleusercontent.com
# RMS_GOOGLE_CLIENT_SECRET=your-rms-google-client-secret
# RMS_GOOGLE_REDIRECT_URI=https://rms.fnlsrv.website/<exact-rms-google-callback>
# RMS_GOOGLE_SCOPES=openid email profile
# RMS_SSO_ERROR_RETURN_URI=https://global.fnlsrv.website/sso/error
# LEAVE_GOOGLE_CLIENT_ID=your-leave-google-client-id.apps.googleusercontent.com
# LEAVE_GOOGLE_CLIENT_SECRET=your-leave-google-client-secret
# LEAVE_GOOGLE_REDIRECT_URI=https://leave.fnlsrv.website/<exact-leave-google-callback>
# LEAVE_GOOGLE_SCOPES=openid email profile
# LEAVE_SSO_ERROR_RETURN_URI=https://global.fnlsrv.website/sso/error

# Dedicated key for chat encryption at rest. Generate a long random value and
# retain it for the lifetime of the encrypted messages; changing it makes old
# messages unreadable. Do not reuse a password or OAuth secret.
CHAT_ENCRYPTION_KEY=replace-with-a-long-random-secret

# SMTP for high-priority announcements, 24-hour unread-chat reminders, and new dining-menu emails.
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=no-reply@final.edu.tr
SMTP_FROM_NAME=FIU Global Portal
SMTP_ENABLE_SSL=true
# Required only for the super-admin SMTP notification test action. It is read
# server-side and is never accepted from a browser request.
SMTP_TEST_RECIPIENT=charafihaytam0@gmail.com

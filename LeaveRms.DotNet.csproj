<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
  </ItemGroup>

  <!-- Generated publish/test artifacts must never be treated as static web
       content on the next build. Otherwise a publish into the project folder
       recursively feeds itself back into compilation. -->
  <ItemGroup>
    <Content Remove="publish\**" />
    <None Remove="publish\**" />
    <Content Remove="output\**" />
    <None Remove="output\**" />
    <Content Remove="deploy\**" />
    <None Remove="deploy\**" />
    <Content Remove="deploy-linux-x64\**" />
    <None Remove="deploy-linux-x64\**" />
    <Content Remove="deploy-linux-x64-full\**" />
    <None Remove="deploy-linux-x64-full\**" />
  </ItemGroup>

</Project>
